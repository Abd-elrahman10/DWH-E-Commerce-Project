                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    oi.Order_item_id    AS OrderItemID,
    oi.OrderID          AS OrderID,
    oi.ProductID        AS ProductID,
    oi.Quantity         AS Quantity,
    oi.price_at_purchase AS Price_At_Purchase,
    o.CustomerID        AS CustomerID,
    o.Order_Date        AS Order_Date,
    p.OrderID           AS PaymentOrderID,
    p.Transaction_status AS Transaction_status,
    s.SupplierID        AS SupplierID,
    (oi.Quantity * oi.price_at_purchase) AS Total_Amount
FROM OrderItem_STG oi
JOIN Order_STG   o  ON oi.OrderID  = o.OrderID
JOIN Payment_STG p  ON o.OrderID   = p.OrderID
JOIN Product_STG s  ON oi.ProductID = s.ProductID</property>
