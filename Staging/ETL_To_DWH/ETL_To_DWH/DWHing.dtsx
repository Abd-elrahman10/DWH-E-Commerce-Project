        <DTS:Executable
          DTS:refId="Package\Dimensions\DimDate"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{1BB43FBD-0F27-4E96-9865-C7738A074A5F}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="DimDate"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{DEBFAE9F-E960-4E59-B46C-F87471C05190}"
              SQLTask:SqlStatementSource="USE OnlineShop_DWH&#xA;GO&#xA;&#xA;-- Populate DimDate with all dates 2020 to 2030&#xA;WITH DateRange AS (&#xA;    SELECT CAST('2020-01-01' AS DATE) AS dt&#xA;    UNION ALL&#xA;    SELECT DATEADD(DAY, 1, dt)&#xA;    FROM DateRange&#xA;    WHERE dt &lt; '2030-12-31'&#xA;)&#xA;INSERT INTO DimDate (DateKey, FullDate, Day, Month, Year, Month_Name, Quarter)&#xA;SELECT&#xA;    CONVERT(INT, FORMAT(dt, 'yyyyMMdd'))  AS DateKey,&#xA;    dt                                     AS FullDate,&#xA;    DAY(dt)                               AS Day,&#xA;    MONTH(dt)                             AS Month,&#xA;    YEAR(dt)                              AS Year,&#xA;    DATENAME(MONTH, dt)                   AS Month_Name,&#xA;    DATEPART(QUARTER, dt)                 AS Quarter&#xA;FROM DateRange&#xA;OPTION (MAXRECURSION 5000)&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
